# Vector Prime secrets
# Place at: volumes/secrets/vector-prime/secrets.env on the server.

# SFTP store backing the org files (served by the sftpgo service).
SFTP_URL=sftpgo.nemesis.home.arpa:2022
SFTP_USERNAME=vector-prime
SFTP_PASSWORD=

# Matrix bot the scheduler uses to send reminders.
MATRIX_USER=@vector-prime:matrix.nemesis.home.arpa
MATRIX_PASSWORD=
