# Firecrawl secrets
# Place at: volumes/secrets/firecrawl/secrets.env on the server
#
# With USE_DB_AUTHENTICATION=false set in the compose file, most of these
# are optional. Fill in what you use.

# Optional — enables Firecrawl's own search/scrape features that need keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — proxy for scraping
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Optional — search provider keys (not required if using SearXNG)
# SERPER_API_KEY=
# BRAVE_API_KEY=
